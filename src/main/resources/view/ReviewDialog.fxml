<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fbla.businessboost.controller.ReviewDialogController"
      spacing="16" prefWidth="520" prefHeight="620"
      stylesheets="@../styles.css">
    
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>
    
    <!-- Title -->
    <Label text="Submit Your Review" styleClass="dialog-title">
        <font>
            <Font name="System Bold" size="20"/>
        </font>
    </Label>
    
    <Separator/>
    
    <!-- Rating Section -->
    <VBox spacing="10">
        <Label text="Your Rating:" styleClass="field-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Slider fx:id="ratingSlider" prefWidth="300"/>
            <Label fx:id="ratingValueLabel" text="3 Stars" styleClass="rating-display">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
        </HBox>
    </VBox>
    
    <!-- Review Text Section -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Your Review:" styleClass="field-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <TextArea fx:id="reviewTextArea" 
                  promptText="Share your experience with this business..."
                  wrapText="true" 
                  prefRowCount="4"
                  VBox.vgrow="ALWAYS"/>
    </VBox>
    
    <!-- Bot Honeypot (Invisible to humans, bots will fill it) -->
    <TextField fx:id="honeypotField" visible="false" managed="false"/>
    
    <!-- Proof of Work Math Challenge -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="mathChallengeLabel" text="What is 5 + 3?" styleClass="field-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <TextField fx:id="mathAnswerField" prefWidth="60"/>
    </HBox>
    
    <!-- Sentiment Warning (hidden by default) -->
    <HBox fx:id="sentimentWarningBox" styleClass="sentiment-warning" 
          managed="false" visible="false" alignment="CENTER_LEFT" spacing="6">
        <Label fx:id="sentimentWarningLabel" wrapText="true" 
               text="Your rating seems low for such a positive review. Is this correct?"/>
    </HBox>
    
    <!-- Google reCAPTCHA Section -->
    <VBox spacing="8" styleClass="verification-box">
        <Label text="Verify you're human" styleClass="bot-question">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <WebView fx:id="recaptchaWebView" prefHeight="100" maxHeight="100"/>
        <Label fx:id="captchaStatusLabel" text="" styleClass="help-text" wrapText="true">
            <font>
                <Font size="11"/>
            </font>
        </Label>
        <padding>
            <Insets top="10" right="12" bottom="10" left="12"/>
        </padding>
    </VBox>
    
    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="Submit Review" onAction="#handleSubmit" 
                styleClass="primary-button" prefWidth="130">
            <font>
                <Font name="System Bold" size="13"/>
            </font>
        </Button>
        <Button text="Cancel" onAction="#handleCancel" 
                styleClass="secondary-button" prefWidth="130">
            <font>
                <Font name="System Bold" size="13"/>
            </font>
        </Button>
    </HBox>
    
</VBox>
