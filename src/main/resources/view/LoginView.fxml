<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fbla.businessboost.controller.LoginController" style="-fx-background-color: #f4f4f4;">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="FBLA Business Boost" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
    </Label>

    <Label text="Sign In or Register" textFill="#7f8c8d">
        <font>
            <Font size="16.0" />
        </font>
    </Label>

    <VBox spacing="10.0" maxWidth="300.0">
        <Label text="Username" />
        <TextField fx:id="usernameField" promptText="Enter your username" />
        
        <Label text="Password" />
        <PasswordField fx:id="passwordField" promptText="Enter your password" />
    </VBox>

    <VBox spacing="10.0" maxWidth="300.0" style="-fx-background-color: #e8f4f8; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="Bot Verification:" textFill="#2980b9">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label fx:id="botQuestionLabel" text="What is X + Y?" wrapText="true" />
        <TextField fx:id="botAnswerField" promptText="Enter your answer" />
    </VBox>

    <HBox spacing="20.0" alignment="CENTER">
        <Button text="Login" onAction="#handleLogin" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100;" />
        <Button text="Register" onAction="#handleRegister" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100;" />
    </HBox>
    
    <Label fx:id="statusLabel" text="" textFill="#e74c3c" wrapText="true" />
</VBox>
