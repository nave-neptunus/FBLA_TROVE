<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="14.0" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.fbla.businessboost.controller.LoginController"
      stylesheets="@../styles.css"
      styleClass="login-root">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <!-- Branding -->
    <Label text="🚀 Commercio" styleClass="login-logo">
        <font>
            <Font name="System Bold" size="32.0" />
        </font>
    </Label>

    <Label text="Create Account" styleClass="login-header">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Social Login Circles -->
    <HBox spacing="14.0" alignment="CENTER">
        <Button fx:id="facebookBtn" text="f" onAction="#handleFacebookLogin"
                styleClass="social-btn, social-facebook"/>
        <Button fx:id="googleBtn" text="G" onAction="#handleGoogleLogin"
                styleClass="social-btn, social-google"/>
        <Button fx:id="yahooBtn" text="Y" onAction="#handleYahooLogin"
                styleClass="social-btn, social-yahoo"/>
    </HBox>

    <!-- Separator -->
    <HBox alignment="CENTER" spacing="10" maxWidth="320.0">
        <Separator prefWidth="100" styleClass="login-separator"/>
        <Label text="or use your email" styleClass="login-or-label">
            <font><Font size="11.0"/></font>
        </Label>
        <Separator prefWidth="100" styleClass="login-separator"/>
    </HBox>

    <!-- Input Fields -->
    <VBox spacing="10.0" maxWidth="320.0">
        <TextField fx:id="usernameField" promptText="👤  Username" 
                   styleClass="login-field"/>
        <PasswordField fx:id="passwordField" promptText="🔒  Password"
                       styleClass="login-field"/>
    </VBox>

    <!-- Login / Register Buttons -->
    <VBox spacing="10.0" maxWidth="320.0" alignment="CENTER">
        <Button text="Sign In" onAction="#handleLogin" prefWidth="320" prefHeight="38"
                styleClass="login-btn-primary"/>
        <Button text="Sign Up" onAction="#handleRegister" prefWidth="320" prefHeight="38"
                styleClass="login-btn-secondary"/>
    </VBox>

    <!-- Status Label -->
    <Label fx:id="statusLabel" text="" styleClass="status-error" wrapText="true" maxWidth="320.0"/>
    <Label fx:id="captchaStatusLabel" text="" managed="false" visible="false"/>
</VBox>
