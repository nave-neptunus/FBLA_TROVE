<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fbla.businessboost.controller.MainController"
            stylesheets="@../styles.css">
    
    <!-- Top: Header -->
    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="🚀 FBLA Business Boost" styleClass="app-title">
                    <font>
                        <Font name="System Bold" size="26"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="search-bar-container">
                    <TextField fx:id="zipCodeField" promptText="Enter zip code..." prefWidth="180" 
                               styleClass="search-field"/>
                    <Button text="🔍 Search" onAction="#handleZipSearch" styleClass="search-button"/>
                </HBox>
            </HBox>
            <!-- Category Chips -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="category-chips">
                <padding>
                    <Insets top="10" right="0" bottom="0" left="0"/>
                </padding>
                <ComboBox fx:id="categoryFilter" prefWidth="130" styleClass="category-combo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="⬇ Sort by Rating" onAction="#handleSortByRating" styleClass="sort-button"/>
            </HBox>
            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>
        </VBox>
    </top>
    
    <!-- Left: Favorites Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10" prefWidth="230">
            <Label text="❤️ Favorites" styleClass="section-title">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
            <ListView fx:id="favoritesList" VBox.vgrow="ALWAYS"/>
            <padding>
                <Insets top="15" right="12" bottom="15" left="12"/>
            </padding>
        </VBox>
    </left>
    
    <!-- Center: Card Grid -->
    <center>
        <VBox spacing="0">
            <!-- Inline Result Banner (hidden by default) -->
            <HBox fx:id="resultBanner" styleClass="result-banner" alignment="CENTER_LEFT"
                  spacing="10" managed="false" visible="false">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
                <Label fx:id="resultBannerLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#hideResultBanner" styleClass="banner-close-button"/>
            </HBox>

            <!-- Business Card Grid -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="card-scroll-pane">
                <FlowPane fx:id="businessCardGrid" hgap="20" vgap="20"
                          alignment="CENTER" styleClass="card-grid">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>
    
    <!-- Right: Details Pane -->
    <right>
        <VBox styleClass="detail-pane" spacing="12" prefWidth="320">
            <ImageView fx:id="detailImageView" fitWidth="290" fitHeight="180" preserveRatio="false"
                       styleClass="detail-image"/>
            <Label fx:id="selectedBusinessLabel" text="Select a business" 
                   styleClass="detail-title" wrapText="true">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
            <Label fx:id="businessDescriptionLabel" wrapText="true" styleClass="detail-description">
                <font>
                    <Font size="12"/>
                </font>
            </Label>
            <Separator/>
            <Label text="🔥 Current Deals" styleClass="deals-header">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Label>
            <ListView fx:id="dealsPane" VBox.vgrow="ALWAYS" styleClass="deals-list"/>
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
        </VBox>
    </right>
    
    <!-- Bottom: Action Buttons -->
    <bottom>
        <HBox spacing="15" alignment="CENTER" styleClass="action-bar">
            <Button text="📝 Add Review" onAction="#handleAddReview" 
                    styleClass="action-button" prefWidth="160">
                <font>
                    <Font name="System Bold" size="13"/>
                </font>
            </Button>
            <Button text="📊 Generate Report" onAction="#handleGenerateReport" 
                    styleClass="action-button-outline" prefWidth="160">
                <font>
                    <Font name="System Bold" size="13"/>
                </font>
            </Button>
            <padding>
                <Insets top="12" right="25" bottom="12" left="25"/>
            </padding>
        </HBox>
    </bottom>
    
</BorderPane>
